<?xml version="1.0" encoding="UTF-8"?>
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
>

  <!-- Homepage — highest priority -->
  <url>
    <loc>https://chomoktomok.com/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- Product listing — very important for e-commerce SEO -->
  <url>
    <loc>https://chomoktomok.com/products</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- Auth pages — shown as Google Sitelinks -->
  <url>
    <loc>https://chomoktomok.com/login</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>

  <url>
    <loc>https://chomoktomok.com/register</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>

  <!-- Cart — lower priority, not useful for new visitors -->
  <url>
    <loc>https://chomoktomok.com/cart</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>

</urlset>